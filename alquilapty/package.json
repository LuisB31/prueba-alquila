{
  "name": "alquilapty",
  "version": "2.0.0",
  "private": true,
  "description": "AlquilaPTY: plataforma inmobiliaria de Panamá (frontend estático + API REST en Node/Express).",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/css/tailwind.input.css -o frontend/css/tailwind.css --minify",
    "set-url": "node scripts/set-site-url.js",
    "test": "node --test backend/test/api.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
